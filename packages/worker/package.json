{
  "name": "@antines/worker",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./entry": {
      "import": "./dist/entry.js",
      "types": "./dist/entry.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@antines/protocol": "workspace:*",
    "@antines/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antines-labs/antinesjs.git",
    "directory": "packages/worker"
  }
}
