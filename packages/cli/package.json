{
  "name": "@antines/cli",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/bin/antines.js",
  "types": "dist/bin/antines.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "antines": "./dist/bin/antines.js"
  },
  "exports": {
    ".": {
      "import": "./dist/bin/antines.js",
      "types": "./dist/bin/antines.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@antines/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antines-labs/antinesjs.git",
    "directory": "packages/cli"
  }
}
