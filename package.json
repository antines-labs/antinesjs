{
  "name": "antines",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antines-labs/antinesjs.git"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
